@{
    ViewData["Title"] = "About the Library";
}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="hero-panel p-4 p-md-5 rounded-4">
            <div class="display-5 mb-3">📚</div>
            <h1 class="h2">About the College Library</h1>
            <p class="lead">A simple digital register for managing books issued to students.</p>
            <p>This application helps library staff record student details, track expected return dates, identify overdue books and calculate late-return fines.</p>
            <a asp-action="Index" class="btn btn-primary mt-2">View issued books</a>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Book catalogue</h2><p class="text-muted small mb-0">View sample titles, authors and available copies.</p></div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Issue tracking</h2><p class="text-muted small mb-0">Record member and issue details through a validated form.</p></div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Fine calculation</h2><p class="text-muted small mb-0">Calculate sample fines at ₹10 per overdue day.</p></div></div></div>
        </div>
    </div>
</div>
