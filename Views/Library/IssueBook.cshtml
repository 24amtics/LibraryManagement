@model LibraryMember
@{
    ViewData["Title"] = "Issue a Book";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="h2">Issue a Book</h1>
            <p class="text-muted">Enter the student details and book issue dates.</p>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Library" asp-action="IssueBook" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="MemberName" class="form-label">Member Name</label>
                            <input asp-for="MemberName" class="form-control" placeholder="Enter student name" />
                            <span asp-validation-for="MemberName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label"></label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. CSE" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="student@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BookId" class="form-label">Book ID</label>
                            <input asp-for="BookId" class="form-control" type="number" min="1" />
                            <div class="form-text">Sample catalogue IDs: 1, 2, 3.</div>
                            <span asp-validation-for="BookId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IssueDate" class="form-label"></label>
                            <input asp-for="IssueDate" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" />
                            <span asp-validation-for="IssueDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ReturnDate" class="form-label">Expected Return Date</label>
                            <input asp-for="ReturnDate" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" />
                            <span asp-validation-for="ReturnDate" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save Issue</button>
                        <a asp-controller="Library" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
