@model IEnumerable<LibraryMember>
@{
    ViewData["Title"] = "Issued Books";
    var books = ViewBag.Books as List<Book> ?? new List<Book>();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Issued Books</h1>
        <p class="text-muted mb-0">Manage student book issues, due dates and fines.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Library" asp-action="IssueBook">+ Issue a Book</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Issued-book register</h2>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Member</th><th>Department</th><th>Book</th><th>Issue Date</th>
                        <th>Return Date</th><th>Due Date</th><th>Status</th><th>Fine</th><th>Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var member in Model)
                {
                    var book = books.FirstOrDefault(b => b.BookId == member.BookId);
                    var status = member.GetDueStatus();
                    var badge = status == "Overdue" ? "bg-danger" : status == "Due Soon" ? "bg-warning text-dark" : status == "Returned" ? "bg-success" : "bg-secondary";
                    <tr>
                        <td>@member.MemberName</td>
                        <td>@member.Department</td>
                        <td>@(book?.Title ?? $"Book #{member.BookId}")</td>
                        <td>@member.IssueDate.ToString("dd MMM yyyy")</td>
                        <td>@(member.ReturnDate?.ToString("dd MMM yyyy") ?? "Not set")</td>
                        <td>@member.DueDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @badge">@status</span></td>
                        <td>₹@member.CalculateFine().ToString("0.00")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-outline-primary" asp-action="BookDetails" asp-route-id="@member.MemberId">Details</a>
                                @if (!member.ActualReturnDate.HasValue)
                                {
                                    <form asp-action="MarkReturned" asp-route-id="@member.MemberId" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Return</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No books have been issued yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h5">Library catalogue</h2>
        <div class="row g-3">
        @foreach (var book in books)
        {
            <div class="col-md-4">
                <div class="catalogue-card h-100">
                    <div class="text-primary small fw-semibold">@book.Category</div>
                    <h3 class="h6 mt-2">@book.Title</h3>
                    <p class="text-muted small mb-2">by @book.Author</p>
                    <div class="d-flex justify-content-between small">
                        <span>₹@book.Price</span><span>@book.AvailableCopies copies available</span>
                    </div>
                </div>
            </div>
        }
        </div>
    </div>
</div>
